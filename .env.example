# Copy to `.env` and edit. `.env` is gitignored.

# Required — process and dictionary data live in MongoDB.
# MONGODB_URI=mongodb://localhost:27017/processportal

# First-time setup:
# 1. Start MongoDB (local, Docker, or Atlas).
# 2. Seed from JSON snapshot: npm run db:seed-mongo
#    (reads seed-data/processes and seed-data/dictionaries — see seed-data/README.md)
# 3. Start the server: npm run dev:server

# OpenAI — text import (paste → process JSON). Without OPENAI_API_KEY the API returns 501 for text import.
# OPENAI_API_KEY=
# Optional; default in code is gpt-4o if unset:
# OPENAI_MODEL=gpt-4o
# Optional; default https://api.openai.com/v1 — use for OpenAI-compatible proxies:
# OPENAI_BASE_URL=https://api.openai.com/v1
