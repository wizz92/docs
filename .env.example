# Data backend: 'json' (default) | 'mongodb'
# Copy to .env and edit. .env is gitignored.

DATA_BACKEND=json

# Required when DATA_BACKEND=mongodb:
# MONGODB_URI=mongodb://localhost:27017/processportal

# First-time MongoDB setup:
# 1. Start MongoDB (e.g. local: brew services start mongodb-community, or use Atlas).
# 2. Import from JSON: npm run db:seed-mongo
#    For incremental sync without wiping: npm run db:seed-mongo -- --upsert
# 3. Switch backend: DATA_BACKEND=mongodb
# 4. Start the server: npm run dev:server

# OpenAI — text import (paste → process JSON). Without OPENAI_API_KEY the API returns 501 for text import.
# OPENAI_API_KEY=
# Optional; default in code is gpt-4o if unset:
# OPENAI_MODEL=gpt-4o
# Optional; default https://api.openai.com/v1 — use for OpenAI-compatible proxies:
# OPENAI_BASE_URL=https://api.openai.com/v1
