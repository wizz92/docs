{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/01-regular-reviews/sop-05.json","level":"sop","folderPath":"06-management-cadence-coordination/01-regular-reviews","fileName":"sop-05.json","type":"sop","data":{"name":"Как готовить отчётность для review","type":"sop","purpose":"Как готовить отчётность для review.","description":"Практическая инструкция: как готовить отчётность для review.","main_goal":"Готовить отчётность для review — выполнено.","when_used":"По наступлении триггера.","triggers":["За 1 день до соответствующего review"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Определить, для какого review готовится отчёт: weekly / sprint / initiative / function","description":""},{"step":"Собрать данные: из Jira (sprint data), из trackers (goals, initiatives), от Team Leads (blockers, risks)","description":""},{"step":"Для sprint report: velocity, completion rate, carry-over, key deliverables, blockers","description":""},{"step":"Для initiative report: status per initiative, RAG status (Red/Amber/Green), milestones, confidence","description":""},{"step":"Присвоить RAG status по критериям: Green = on track, Amber = at risk but manageable, Red = off track / needs decision","description":""},{"step":"Оформить в стандартном формате (1 page per report). Фокус на сигналах, а не на деталях","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Отчёт = dump данных без выводов — management не понимает, что важно","symptom":"","action":""},{"failure":"RAG status субъективен без критериев — всё зелёное","symptom":"","action":""},{"failure":"Отчёт готовится за 5 минут до review — качество низкое","symptom":"","action":""}],"linked_templates_forms_links":["Sprint status template","Initiative report template","RAG criteria guide"],"owner":"Operations lead / Report owner","version":"2.0","updated_at":"2026-03-12"},"_id":"ty2kalHyv20L4jId"}
