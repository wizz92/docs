{"domainId":"strategy-governance","domainPath":"strategy-governance/03-portfolio-prioritization/process.json","level":"l2","folderPath":"03-portfolio-prioritization","fileName":"process.json","type":"process_l2","data":{"name":"Приоритизация портфеля","type":"process_l2","purpose":"Обеспечить, что компания инвестирует ресурсы в правильные инициативы в правильном порядке.","description":"Процесс сбора, оценки, ранжирования и ребалансировки портфеля инициатив компании.","main_goal":"Портфель инициатив приоритизирован, ресурсы распределены, low-priority items отложены.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Начало квартала","Появление крупной новой инициативы","Существенное изменение ресурсов"],"inputs":["Список всех инициатив","Стратегические приоритеты","Capacity и бюджет","Impact оценки"],"outputs":["Приоритизированный портфель","Решения по отложенным инициативам","Resource allocation plan"],"owner":"COO / Head of Strategy","participants":["CEO","COO","Heads of Functions","Product Owners"],"linked_l3_subprocesses":["Сбор инициатив в портфель","Приоритизация портфеля","Ребалансировка портфеля"],"linked_sop":["Как зарегистрировать новую инициативу","Как провести первичную оценку инициативы","Как подготовить portfolio register к review","Как провести portfolio prioritization session","Как распределить ресурсы по инициативам","Как коммуницировать решения по портфелю","Как оценить impact изменений на портфель","Как провести экстренную ребалансировку","Как зафиксировать решения по ребалансировке"],"linked_meetings":["Portfolio review","Prioritization session"],"process_steps":[{"step":"Собрать все инициативы в единый реестр","description":"Собрать от всех функций список текущих и планируемых инициатив"},{"step":"Оценить и ранжировать","description":"Применить scoring model (impact, effort, alignment) и провести forced ranking"},{"step":"Ребалансировать портфель","description":"Сверить с capacity, убрать / отложить low-priority, зафиксировать решения"}],"process_rhythm":[{"horizon":"Квартал","ritual":"Portfolio review","key_question":"Правильные ли инициативы в работе?","result":"Обновлённый приоритизированный портфель"},{"horizon":"Месяц","ritual":"Portfolio health check","key_question":"Нет ли перегрузки или брошенных инициатив?","result":"Решения по ребалансировке"}],"typical_failures":[{"failure":"Всё в приоритете","symptom":"Нет forced ranking, все инициативы must-have","action":"Применить жёсткий scoring, убрать bottom 20%"},{"failure":"Портфель не пересматривается","symptom":"Инициативы добавляются, но никогда не убираются","action":"Ввести обязательный quarterly portfolio review с cut-off"}],"linked_artifacts":[{"name":"Приоритизация портфеля","description":"Основной артефакт процесса Приоритизация портфеля"}],"linked_systems":["Jira Portfolio","Spreadsheet trackers","BI dashboards"],"metrics_signals":["Доля инициатив с owner и priority","Количество инициатив без ресурса"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"UnT7XwD3Hb8E0ea4"}
