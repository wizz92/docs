{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/01-regular-reviews/process.json","level":"l3","folderPath":"06-management-cadence-coordination/01-regular-reviews","fileName":"process.json","type":"process_l3","data":{"name":"Регулярные review","type":"process_l3","purpose":"Создать регулярный управленческий цикл обзоров, решений и follow-up.","description":"Организация и проведение weekly ops review, sprint-to-management review, initiative review, function review. Включает подготовку отчётности для review.","main_goal":"Management регулярно видит состояние работы и принимает решения, а не реагирует ситуативно.","when_used":"Постоянно, по установленному cadence.","cadence":"Weekly + per sprint + monthly","triggers":["Наступление review cycle"],"inputs":["Reports and statuses","Goal/initiative signals","Risks, blockers, escalations","Capacity shifts"],"outputs":["Review outcomes","Management decisions","Action items","Follow-up list"],"owner":"COO / Operations lead","participants":["CEO","Heads of Functions","Relevant owners","Operations"],"linked_meetings":["Weekly ops review","Sprint-to-management review","Initiative review","Function review"],"linked_artifacts":["Review agenda","Management summary","Decision log","Action list"],"linked_systems":["Jira","Confluence"],"linked_sop":["Как подготовить и провести weekly ops review","Как подготовить management summary по итогам спринта","Как подготовить и провести initiative review","Как провести function review","Как готовить отчётность для review"],"done_criteria":["Review проведён по cadence","Решения зафиксированы","Action items назначены"],"typical_failures":[{"failure":"Review отменяется / переносится постоянно","symptom":"","action":"Если review пропущен — provести make-up или async decision round"},{"failure":"Review без решений — только status reading","symptom":"","action":""},{"failure":"Actions не follow-up'ятся","symptom":"","action":""}],"version":"2.0","updated_at":"2026-03-12"},"_id":"hAyqlylXC1nPoWgb"}
{"domainId":"operational-management","domainPath":"operational-management/04-readiness-management/02-go-no-go-decision/sop-03.json","level":"sop","folderPath":"04-readiness-management/02-go-no-go-decision","fileName":"sop-03.json","type":"sop","data":{"name":"Как проверить исполнение условий go","type":"sop","purpose":"Как проверить исполнение условий go.","description":"Практическая инструкция: как проверить исполнение условий go.","main_goal":"Проверить исполнение условий go — выполнено.","when_used":"По наступлении триггера.","triggers":["Приближение дедлайна conditions"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Для каждого condition из CONDITIONAL GO: проверить исполнение к дедлайну","description":""},{"step":"Если condition не выполнено: эскалировать owner condition, обсудить варианты (продлить / снять / переоценить риск)","description":""},{"step":"Зафиксировать статус каждого condition в decision record","description":""},{"step":"Если все conditions выполнены — подтвердить полный GO","description":""},{"step":"Если critical condition не выполнено — пересмотреть go/no-go решение","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Conditions не отслеживаются — CONDITIONAL GO де-факто = GO без условий","symptom":"","action":""},{"failure":"Non-compliance не эскалируется — risks реализуются","symptom":"","action":""}],"linked_templates_forms_links":[],"owner":"Launch owner / Operations lead","version":"2.0","updated_at":"2026-03-12"},"_id":"hHFPf8BYO1Zcce40"}
