{"domainId":"business-development","domainPath":"business-development/01-niche-research/process.json","level":"l2","folderPath":"01-niche-research","fileName":"process.json","type":"process_l2","data":{"name":"Исследование ниш","type":"process_l2","purpose":"Системно исследовать рыночные ниши для выявления перспективных направлений роста.","description":"Процесс сканирования рынка, анализа конкурентной среды и валидации привлекательности ниш.","main_goal":"Список валидированных ниш с оценкой потенциала и рекомендациями.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Запрос CEO на поиск новых направлений","Квартальный цикл growth review"],"inputs":["Рыночные тренды","Данные о конкурентах","Customer feedback","Финансовые модели"],"outputs":["Niche assessment report","Shortlist перспективных ниш","Go/no-go рекомендации"],"owner":"Head of BD","participants":["Head of BD","Market analyst","Product lead"],"linked_l3_subprocesses":["Сканирование рынка","Анализ конкурентной среды","Валидация ниши"],"linked_sop":["Как провести monthly market scan","Как зарегистрировать новую рыночную возможность","Как приоритизировать opportunities для deep-dive","Как собрать данные о конкурентах","Как подготовить competitive landscape report","Как обновить competitive intelligence","Как спланировать niche validation","Как провести customer discovery для ниши","Как подготовить go/no-go recommendation"],"linked_meetings":["Niche review meeting"],"process_steps":[{"step":"Сканировать рынок","description":"Собрать данные о трендах, новых сегментах и потребностях"},{"step":"Провести анализ конкурентов в нише","description":"Оценить уровень конкуренции, барьеры входа и дифференциаторы"},{"step":"Валидировать привлекательность ниши","description":"Оценить TAM/SAM, unit economics potential, strategic fit"}],"process_rhythm":[{"horizon":"Квартал","ritual":"Niche pipeline review","key_question":"Какие ниши исследуем и какие результаты?","result":"Updated niche pipeline"}],"typical_failures":[{"failure":"Исследование поверхностное","symptom":"Ниши выглядят привлекательно, но нет данных для решения","action":"Ввести чек-лист минимальных данных для niche assessment"}],"linked_artifacts":[{"name":"Исследование ниш","description":"Основной артефакт процесса Исследование ниш"}],"linked_systems":["Market research tools","BI dashboards","CRM"],"metrics_signals":["Количество исследованных ниш в квартал","Время от идеи до assessment"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"dNs9atb9oB9QboDG"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/01-strategic-planning/01-strategic-analysis/sop-03.json","level":"sop","folderPath":"01-strategic-planning/01-strategic-analysis","fileName":"sop-03.json","type":"sop","data":{"name":"Как подготовить strategy briefing","type":"sop","purpose":"Подготовить краткий документ с ключевыми findings для CEO и руководителей.","description":"Подготовить краткий документ с ключевыми findings для CEO и руководителей.","main_goal":"Подготовить краткий документ с ключевыми findings для CEO и руководителей.","when_used":"По триггеру процесса.","triggers":["Данные для анализа собраны"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Выделить 5–7 ключевых findings","description":""},{"step":"Структурировать по блокам: рынок, клиенты, конкуренты, внутреннее состояние","description":""},{"step":"Подготовить executive summary на 1 страницу","description":""},{"step":"Согласовать с CEO до рассылки","description":""},{"step":"Разослать участникам strategy offsite","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"CSO / Head of Strategy","version":"1.0","updated_at":"2026-03-12"},"_id":"dVFCihE0yS68hQ8w"}
{"domainId":"business-development","domainPath":"business-development/02-growth-testing/process.json","level":"l2","folderPath":"02-growth-testing","fileName":"process.json","type":"process_l2","data":{"name":"Тестирование гипотез роста","type":"process_l2","purpose":"Быстро и дёшево тестировать гипотезы роста перед масштабными инвестициями.","description":"Процесс формулирования, проведения и анализа growth experiments.","main_goal":"Подтверждённые или опровергнутые гипотезы роста с данными для решений.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Новая гипотеза роста","Результаты niche validation","Квартальный growth review"],"inputs":["Validated niche","Growth hypothesis","Budget для эксперимента"],"outputs":["Experiment results","Data-driven decision: scale / pivot / kill"],"owner":"Head of Growth / Head of BD","participants":["Head of Growth","Product lead","Marketing","Data analyst"],"linked_l3_subprocesses":["Формулирование гипотез роста","Проведение экспериментов","Анализ результатов экспериментов"],"linked_sop":["Как написать hypothesis card","Как приоритизировать hypothesis backlog","Как спланировать growth experiment","Как запустить growth experiment","Как мониторить эксперимент","Как завершить эксперимент и собрать данные","Как проанализировать результаты эксперимента","Как подготовить experiment decision report","Как провести experiment retrospective"],"linked_meetings":["Hypothesis board review","Experiment retrospective"],"process_steps":[{"step":"Сформулировать гипотезу","description":"Описать гипотезу, expected outcome, success criteria и минимальный эксперимент"},{"step":"Провести эксперимент","description":"Запустить MVP / test, собрать данные"},{"step":"Проанализировать и решить","description":"Сравнить результат с success criteria, принять решение: scale / pivot / kill"}],"process_rhythm":[{"horizon":"Неделя","ritual":"Experiment standup","key_question":"Какие эксперименты в работе и какие результаты?","result":"Updated experiment board"},{"horizon":"Месяц","ritual":"Growth review","key_question":"Какие гипотезы подтвердились и что масштабируем?","result":"Decisions: scale / pivot / kill"}],"typical_failures":[{"failure":"Эксперименты затягиваются","symptom":"Нет результатов за 2+ недели","action":"Timebox эксперименты до 2 недель, kill затянувшиеся"},{"failure":"Нет чётких success criteria","symptom":"Непонятно, успешен ли эксперимент","action":"Требовать success criteria до запуска"}],"linked_artifacts":[{"name":"Тестирование гипотез роста","description":"Основной артефакт процесса Тестирование гипотез роста"}],"linked_systems":["Analytics tools","A/B testing platform","CRM"],"metrics_signals":["Количество экспериментов в месяц","Win rate экспериментов","Time to decision"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"dYFctGgAkiZfZChd"}
