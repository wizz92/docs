{"domainId":"business-development","domainPath":"business-development/01-niche-research/01-market-scanning/process.json","level":"l3","folderPath":"01-niche-research/01-market-scanning","fileName":"process.json","type":"process_l3","data":{"name":"Сканирование рынка","type":"process_l3","purpose":"Систематически собирать информацию о рыночных трендах и возможностях.","description":"Процесс регулярного мониторинга рынка для выявления новых ниш.","main_goal":"Актуальная карта рыночных возможностей.","when_used":"Регулярно, как часть growth pipeline.","cadence":"Monthly","triggers":["Наступление даты monthly scan","Появление значимого рыночного события"],"inputs":["Рыночные отчёты","Новостные источники","Customer data"],"outputs":["Market scan summary","New opportunity cards"],"owner":"Market analyst","participants":["Market analyst","Head of BD"],"linked_meetings":["Monthly scan review"],"linked_artifacts":["Market scan report"],"linked_systems":["Market research tools","News aggregators"],"linked_sop":["Как провести monthly market scan","Как зарегистрировать новую рыночную возможность","Как приоритизировать opportunities для deep-dive"],"done_criteria":["Отчёт подготовлен и разослан","Новые opportunities зарегистрированы"],"typical_failures":[{"failure":"Данные устарели","symptom":"","action":"Автоматизировать мониторинг ключевых источников"},{"failure":"Пропущен важный тренд","symptom":"","action":"Добавить cross-check с customer-facing командами"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"GAnL7ulXmDHLK4EB"}
{"domainId":"operational-management","domainPath":"operational-management/03-capacity-management/02-bottleneck-resolution/sop-01.json","level":"sop","folderPath":"03-capacity-management/02-bottleneck-resolution","fileName":"sop-01.json","type":"sop","data":{"name":"Как выявить и проанализировать bottleneck","type":"sop","purpose":"Как выявить и проанализировать bottleneck.","description":"Практическая инструкция: как выявить и проанализировать bottleneck.","main_goal":"Выявить и проанализировать bottleneck — выполнено.","when_used":"По наступлении триггера.","triggers":["Обнаружение паттерна recurring delays или blocked work"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Определить симптомы: recurring blocked items, одна роль/команда всегда задерживает, work piling up перед одним этапом","description":""},{"step":"Собрать данные: сколько items blocked, как долго, кто/что blocking","description":""},{"step":"Провести root cause analysis: ресурсный дефицит? Процессная проблема? Skill gap? Внешняя зависимость?","description":""},{"step":"Оценить impact: high (блокирует > 1 команду / критичную инициативу), medium, low","description":""},{"step":"Задокументировать в bottleneck register: описание, root cause, impact, affected teams","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Симптом принимается за root cause — лечится следствие","symptom":"","action":""},{"failure":"Impact не оценён — не понятно, насколько критично","symptom":"","action":""},{"failure":"Не задокументировано — проблема «известна всем», но никто не решает","symptom":"","action":""}],"linked_templates_forms_links":[],"owner":"Operations lead / Team Lead","version":"2.0","updated_at":"2026-03-12"},"_id":"GBLc4iogYnV4djXN"}
