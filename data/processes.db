{"domainId":"finance-control","domainPath":"finance-control/02-expense-approval/process.json","level":"l2","folderPath":"02-expense-approval","fileName":"process.json","type":"process_l2","data":{"name":"Согласование расходов","type":"process_l2","purpose":"Обеспечить контролируемое и быстрое согласование расходов.","description":"Процесс подачи, согласования и контроля расходов.","main_goal":"Расходы согласованы в срок, соответствуют бюджету.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Начало цикла согласование расходов","Запрос от руководства"],"inputs":["Данные для согласование расходов","Стратегические приоритеты","Предыдущие результаты"],"outputs":["Результат согласование расходов","Управленческие решения"],"owner":"Finance Manager","participants":["Finance Manager","Budget owner","CFO"],"linked_l3_subprocesses":["Подача заявки на расход","Согласование и утверждение","Постоплатный контроль"],"linked_sop":["Как подготовиться к подача заявки на расход","Как провести подача заявки на расход","Как оценить результаты подача заявки на расход","Как подготовиться к согласование и утверждение","Как провести согласование и утверждение","Как оценить результаты согласование и утверждение","Как подготовиться к постоплатный контроль","Как провести постоплатный контроль","Как оценить результаты постоплатный контроль"],"linked_meetings":["Expense Approval review"],"process_steps":[{"step":"Подготовить inputs для согласование расходов","description":"Собрать данные, проверить готовность"},{"step":"Провести согласование расходов","description":"Выполнить основные действия процесса"},{"step":"Оценить результат и принять решения","description":"Проверить outputs, зафиксировать решения"}],"process_rhythm":[{"horizon":"Per cycle","ritual":"Expense Approval review","key_question":"Как работает согласование расходов?","result":"Decisions and improvements"}],"typical_failures":[{"failure":"Согласование расходов не проводится регулярно","symptom":"Пропуски циклов, нет данных","action":"Зафиксировать cadence, назначить ответственного"}],"linked_artifacts":[{"name":"Согласование расходов","description":"Основной артефакт процесса Согласование расходов"}],"linked_systems":["Jira","Confluence / wiki","BI dashboards"],"metrics_signals":["Эффективность согласование расходов","Время цикла"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"NITeSoa87ybgmZCX"}
{"domainId":"hr-organization","domainPath":"hr-organization/03-performance-review/01-review-prep/sop-01.json","level":"sop","folderPath":"03-performance-review/01-review-prep","fileName":"sop-01.json","type":"sop","data":{"name":"Как подготовиться к подготовка к review cycle","type":"sop","purpose":"Обеспечить готовность к выполнению подготовка к review cycle.","description":"Обеспечить готовность к выполнению подготовка к review cycle.","main_goal":"Обеспечить готовность к выполнению подготовка к review cycle.","when_used":"По триггеру процесса.","triggers":["Приближение срока подготовка к review cycle"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Определить входные данные для подготовка к review cycle","description":""},{"step":"Собрать необходимую информацию от ответственных","description":""},{"step":"Проверить готовность по чек-листу","description":""},{"step":"Согласовать план с owner","description":""},{"step":"Зафиксировать в рабочем документе","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"HR BP / Head of HR","version":"1.0","updated_at":"2026-03-12"},"_id":"NKSBvveeN5g7aRNE"}
{"domainId":"hr-organization","domainPath":"hr-organization/02-onboarding/01-pre-onboarding/process.json","level":"l3","folderPath":"02-onboarding/01-pre-onboarding","fileName":"process.json","type":"process_l3","data":{"name":"Подготовка к выходу сотрудника","type":"process_l3","purpose":"Обеспечить выполнение подготовка к выходу сотрудника в рамках адаптация.","description":"Процесс подготовки, проведения и контроля качества подготовка к выходу сотрудника.","main_goal":"Результат подготовка к выходу сотрудника соответствует стандартам и ожиданиям.","when_used":"В рамках адаптация, по расписанию или по событию.","cadence":"Per cycle","triggers":["Наступление срока подготовка к выходу сотрудника","Запрос от руководства"],"inputs":["Данные для подготовка к выходу сотрудника","Регламент процесса","Предыдущие результаты"],"outputs":["Результат подготовка к выходу сотрудника","Отчёт / summary","Action items"],"owner":"HR BP / Hiring Manager","participants":["HR BP","Hiring Manager","Buddy","New employee"],"linked_meetings":["Подготовка к выходу сотрудника meeting"],"linked_artifacts":["Подготовка к выходу сотрудника template"],"linked_systems":["Confluence / wiki","Jira"],"linked_sop":["Как подготовиться к подготовка к выходу сотрудника","Как провести подготовка к выходу сотрудника","Как оценить результаты подготовка к выходу сотрудника"],"done_criteria":["Результат подготовка к выходу сотрудника принят","Отчёт подготовлен"],"typical_failures":[{"failure":"Задержка в подготовка к выходу сотрудника","symptom":"","action":"Эскалировать на owner"},{"failure":"Неполные данные","symptom":"","action":"Перенести на следующий цикл с причиной"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"NnO5Tk68roJUNITa"}
