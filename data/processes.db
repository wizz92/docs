{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/01-regular-reviews/sop-04.json","level":"sop","folderPath":"06-management-cadence-coordination/01-regular-reviews","fileName":"sop-04.json","type":"sop","data":{"name":"Как провести function review","type":"sop","purpose":"Как провести function review.","description":"Практическая инструкция: как провести function review.","main_goal":"Провести function review — выполнено.","when_used":"По наступлении триггера.","triggers":["Monthly / quarterly"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Попросить Head of Function подготовить обзор: ключевые результаты, проблемы, people issues, requests","description":""},{"step":"На review: пройти по обзору, обсудить health функции/команды","description":""},{"step":"Оценить health: delivery pace, team morale signals, capacity, process issues","description":""},{"step":"Зафиксировать follow-up actions: что нужно от management, что Head решает сам","description":""},{"step":"Обновить function health status в общем tracker","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Review формальный — Head отчитывается, но не поднимает реальные проблемы","symptom":"","action":""},{"failure":"People issues не обсуждаются — morale проблемы копятся","symptom":"","action":""},{"failure":"Follow-up не контролируется","symptom":"","action":""}],"linked_templates_forms_links":["Function review template"],"owner":"COO","version":"2.0","updated_at":"2026-03-12"},"_id":"XDkKdlkLPWAnL3Xe"}
