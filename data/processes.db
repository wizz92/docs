{"domainId":"strategy-governance","domainPath":"strategy-governance/01-strategic-planning/process.json","level":"l2","folderPath":"01-strategic-planning","fileName":"process.json","type":"process_l2","data":{"name":"Стратегическое планирование","type":"process_l2","purpose":"Сформировать и обновлять стратегию компании, чтобы все решения и приоритеты были выстроены вокруг единого направления.","description":"Процесс анализа среды, формулирования стратегических выборов и фиксации стратегии в виде документа, доступного всем руководителям.","main_goal":"Актуальная, принятая руководством стратегия с понятными стратегическими выборами.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Начало года","Существенное изменение рынка","Запрос Board / CEO"],"inputs":["Рыночный анализ","Финансовые результаты","Feedback от клиентов и команд","Конкурентный ландшафт"],"outputs":["Стратегический документ","Стратегические приоритеты","Список ключевых ставок"],"owner":"CEO / CSO","participants":["CEO","COO","Heads of Functions","External advisors"],"linked_l3_subprocesses":["Стратегический анализ","Формирование стратегии","Коммуникация стратегии"],"linked_sop":["Как собрать данные для стратегического анализа","Как провести конкурентный анализ","Как подготовить strategy briefing","Как подготовить и провести strategy offsite","Как зафиксировать стратегию в документе","Как каскадировать стратегию на руководителей","Как подготовить all-hands по стратегии","Как провести team-level strategy briefing","Как поддерживать актуальность strategy FAQ"],"linked_meetings":["Strategy offsite","Strategy review"],"process_steps":[{"step":"Провести стратегический анализ","description":"Собрать данные о рынке, конкурентах, клиентах и внутреннем состоянии компании"},{"step":"Сформулировать стратегические выборы","description":"Определить where to play, how to win, ключевые ставки"},{"step":"Утвердить и донести стратегию","description":"Провести strategy offsite, зафиксировать документ, каскадировать на руководителей"}],"process_rhythm":[{"horizon":"Год","ritual":"Strategy offsite","key_question":"Куда движется компания и на чём фокусируемся?","result":"Утверждённая стратегия и приоритеты"},{"horizon":"Полгода","ritual":"Strategy review","key_question":"Стратегия всё ещё актуальна или нужен pivot?","result":"Решение: подтверждение / корректировка стратегии"}],"typical_failures":[{"failure":"Стратегия написана, но не донесена","symptom":"Руководители интерпретируют приоритеты по-разному","action":"Провести каскадную сессию, зафиксировать FAQ"},{"failure":"Анализ поверхностный","symptom":"Стратегия не учитывает реальные рыночные изменения","action":"Привлечь внешнюю экспертизу, провести deep-dive"}],"linked_artifacts":[{"name":"Стратегическое планирование","description":"Основной артефакт процесса Стратегическое планирование"}],"linked_systems":["Confluence / wiki","Presentation tools","BI dashboards"],"metrics_signals":["Наличие актуальной стратегии","Время от insight до стратегического решения"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"ipmapmZYFmqcZwDu"}
