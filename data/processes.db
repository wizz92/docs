{"domainId":"product-delivery","domainPath":"product-delivery/01-backlog-management/process.json","level":"l2","folderPath":"01-backlog-management","fileName":"process.json","type":"process_l2","data":{"name":"Управление бэклогом","type":"process_l2","purpose":"Обеспечить наличие качественного, приоритизированного backlog, готового к планированию.","description":"Процесс сбора требований, приоритизации, refinement и поддержания healthy backlog.","main_goal":"Backlog всегда содержит достаточно готовых к разработке items для 2+ спринтов.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Новый feature request","Результат customer research","Technical debt review"],"inputs":["Feature requests","Customer feedback","Technical debt items","Bug reports"],"outputs":["Prioritized backlog","Refined user stories","Sprint-ready items"],"owner":"Product Owner","participants":["Product Owner","Scrum Master","Tech Lead","Designers","Stakeholders"],"linked_l3_subprocesses":["Сбор и приоритизация требований","Grooming backlog","Управление техническим долгом"],"linked_sop":["Как зарегистрировать новый request","Как провести weekly intake review","Как приоритизировать backlog items","Как подготовить items к refinement session","Как провести backlog refinement session","Как управлять Definition of Ready","Как зарегистрировать tech debt item","Как провести quarterly tech debt review","Как включить tech debt в sprint"],"linked_meetings":["Backlog refinement","Prioritization review"],"process_steps":[{"step":"Собрать и зарегистрировать требования","description":"Принять feature requests, bugs, tech debt items в единый backlog"},{"step":"Приоритизировать","description":"Ранжировать items по impact, effort и strategic alignment"},{"step":"Провести refinement","description":"Детализировать top items: acceptance criteria, estimates, dependencies"}],"process_rhythm":[{"horizon":"Неделя","ritual":"Backlog refinement","key_question":"Достаточно ли ready items для следующего спринта?","result":"Refined и estimated items"},{"horizon":"Квартал","ritual":"Backlog health review","key_question":"Backlog отражает приоритеты?","result":"Cleaned up, re-prioritized backlog"}],"typical_failures":[{"failure":"Backlog раздут","symptom":"500+ items, большинство never будут сделаны","action":"Quarterly cleanup, archive items older than 6 months"},{"failure":"Items не refined","symptom":"Sprint planning затягивается, estimates неточные","action":"Обязательный refinement за 1 спринт до работы"}],"linked_artifacts":[{"name":"Управление бэклогом","description":"Основной артефакт процесса Управление бэклогом"}],"linked_systems":["Jira","Figma","Confluence / wiki"],"metrics_signals":["Количество sprint-ready items","Среднее время от request до refinement"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"xytuvqt6OdlggJMh"}
{"domainId":"operational-management","domainPath":"operational-management/01-operational-planning/02-period-planning/sop-05.json","level":"sop","folderPath":"01-operational-planning/02-period-planning","fileName":"sop-05.json","type":"sop","data":{"name":"Как опубликовать monthly operational plan","type":"sop","purpose":"Как опубликовать monthly operational plan.","description":"Практическая инструкция: как опубликовать monthly operational plan.","main_goal":"Опубликовать monthly operational plan — выполнено.","when_used":"По наступлении триггера.","triggers":["Monthly planning review завершён"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Финализировать monthly plan: приоритеты, инициативы, owners, milestones, зависимости","description":""},{"step":"Опубликовать в Confluence: использовать стандартный шаблон monthly plan","description":""},{"step":"Отправить summary всем Heads и Team Leads с ссылкой","description":""},{"step":"На ближайшем weekly ops review: подтвердить, что план понят и принят","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"1 рабочий день после review","typical_failures":[{"failure":"План опубликован, но никто не уведомлён","symptom":"","action":""},{"failure":"План не обсуждён на review — формальный документ","symptom":"","action":""}],"linked_templates_forms_links":["Monthly plan template (Confluence)"],"owner":"Operations lead","version":"2.0","updated_at":"2026-03-12"},"_id":"y2twxZjtgNf35goS"}
{"domainId":"transformation-automation","domainPath":"transformation-automation/01-process-improvement/02-improvement-design/sop-02.json","level":"sop","folderPath":"01-process-improvement/02-improvement-design","fileName":"sop-02.json","type":"sop","data":{"name":"Как провести проектирование улучшений","type":"sop","purpose":"Выполнить проектирование улучшений по установленной процедуре.","description":"Выполнить проектирование улучшений по установленной процедуре.","main_goal":"Выполнить проектирование улучшений по установленной процедуре.","when_used":"По триггеру процесса.","triggers":["Все inputs для проектирование улучшений готовы"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Начать выполнение проектирование улучшений по процедуре","description":""},{"step":"Фиксировать промежуточные результаты","description":""},{"step":"При отклонениях — уведомить owner","description":""},{"step":"Завершить и проверить результат","description":""},{"step":"Зафиксировать outputs","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"Head of Transformation / Process Owner","version":"1.0","updated_at":"2026-03-12"},"_id":"y3nfiB91nPWLo1V1"}
{"domainId":"operational-management","domainPath":"operational-management/04-readiness-management/01-readiness-check/sop-02.json","level":"sop","folderPath":"04-readiness-management/01-readiness-check","fileName":"sop-02.json","type":"sop","data":{"name":"Как проверить готовность к спринту","type":"sop","purpose":"Как проверить готовность к спринту.","description":"Практическая инструкция: как проверить готовность к спринту.","main_goal":"Проверить готовность к спринту — выполнено.","when_used":"По наступлении триггера.","triggers":["Перед стартом спринта"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Проверить capacity: все ли члены команды доступны? Учтены отпуска?","description":""},{"step":"Проверить sprint backlog: все items ready? Sprint goal сформулирован?","description":""},{"step":"Проверить внешние зависимости: API / данные / решения от других команд — получены?","description":""},{"step":"Оценить sprint risks: что может пойти не так? Есть ли митигации?","description":""},{"step":"Зафиксировать readiness decision: GO (всё ready) / CONDITIONAL GO (есть risks, но manageable) / NO GO (критичные blockers)","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Зависимости не проверены — блокер через 2 дня после старта","symptom":"","action":""},{"failure":"Risks не оценены — surprise в середине спринта","symptom":"","action":""},{"failure":"NO GO не используется — спринт стартует всегда, даже когда не должен","symptom":"","action":""}],"linked_templates_forms_links":["Sprint readiness checklist"],"owner":"Team Lead","version":"2.0","updated_at":"2026-03-12"},"_id":"y7ANPgZUr3OmEGrN"}
{"domainId":"operational-management","domainPath":"operational-management/03-capacity-management/01-capacity-load-review/sop-04.json","level":"sop","folderPath":"03-capacity-management/01-capacity-load-review","fileName":"sop-04.json","type":"sop","data":{"name":"Как обновить capacity review","type":"sop","purpose":"Как обновить capacity review.","description":"Практическая инструкция: как обновить capacity review.","main_goal":"Обновить capacity review — выполнено.","when_used":"По наступлении триггера.","triggers":["Конец каждого planning cycle"],"preconditions":[],"inputs":[],"process_steps":[{"step":"После каждого planning cycle: обновить capacity tracker с фактическими данными","description":""},{"step":"Сравнить plan vs fact: точность предыдущего расчёта","description":""},{"step":"Выделить критичные роли с хронически высокой загрузкой (> 90% 3+ спринта подряд)","description":""},{"step":"Зафиксировать recommendations: нужен ли найм, перераспределение, снижение scope","description":""},{"step":"Представить на monthly ops review","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Capacity review не обновляется — данные устаревают","symptom":"","action":""},{"failure":"Хронический перегруз не выявляется — люди выгорают","symptom":"","action":""}],"linked_templates_forms_links":["Capacity review template"],"owner":"Operations lead","version":"2.0","updated_at":"2026-03-12"},"_id":"yCzNxZNBZBfHhNcd"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/02-goal-setting/03-goal-review/sop-02.json","level":"sop","folderPath":"02-goal-setting/03-goal-review","fileName":"sop-02.json","type":"sop","data":{"name":"Как провести quarterly OKR retrospective","type":"sop","purpose":"Оценить результаты квартала и извлечь уроки.","description":"Оценить результаты квартала и извлечь уроки.","main_goal":"Оценить результаты квартала и извлечь уроки.","when_used":"По триггеру процесса.","triggers":["Конец квартала"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Зафиксировать финальный score по каждому OKR","description":""},{"step":"Провести ретроспективу: что сработало, что нет","description":""},{"step":"Выделить lessons learned для следующего квартала","description":""},{"step":"Опубликовать результаты","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"COO","version":"1.0","updated_at":"2026-03-12"},"_id":"ybTqQOZjZgAMTuBx"}
{"domainId":"revenue-operations","domainPath":"revenue-operations/03-revenue-analysis/03-revenue-review-prep/process.json","level":"l3","folderPath":"03-revenue-analysis/03-revenue-review-prep","fileName":"process.json","type":"process_l3","data":{"name":"Подготовка revenue review","type":"process_l3","purpose":"Обеспечить выполнение подготовка revenue review в рамках анализ выручки.","description":"Процесс подготовки, проведения и контроля качества подготовка revenue review.","main_goal":"Результат подготовка revenue review соответствует стандартам и ожиданиям.","when_used":"В рамках анализ выручки, по расписанию или по событию.","cadence":"Per cycle","triggers":["Наступление срока подготовка revenue review","Запрос от руководства"],"inputs":["Данные для подготовка revenue review","Регламент процесса","Предыдущие результаты"],"outputs":["Результат подготовка revenue review","Отчёт / summary","Action items"],"owner":"Head of Revenue / CFO","participants":["Head of Revenue","Finance analyst","Data analyst","CEO"],"linked_meetings":["Подготовка revenue review meeting"],"linked_artifacts":["Подготовка revenue review template"],"linked_systems":["Confluence / wiki","Jira"],"linked_sop":["Как подготовиться к подготовка revenue review","Как провести подготовка revenue review","Как оценить результаты подготовка revenue review"],"done_criteria":["Результат подготовка revenue review принят","Отчёт подготовлен"],"typical_failures":[{"failure":"Задержка в подготовка revenue review","symptom":"","action":"Эскалировать на owner"},{"failure":"Неполные данные","symptom":"","action":"Перенести на следующий цикл с причиной"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"yj8h4RcAup17070A"}
{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/03-escalation-management/sop-03.json","level":"sop","folderPath":"06-management-cadence-coordination/03-escalation-management","fileName":"sop-03.json","type":"sop","data":{"name":"Как провести эскалацию к руководителю","type":"sop","purpose":"Передать подготовленную эскалацию своему руководителю (и при необходимости руководителю другой стороны) с фокусом на бизнес-риске и конкретном запросе.","description":"Инициатор пишет руководителю, даёт ссылку на Jira-задачу и кратко формулирует контекст, историю горизонтальных попыток, бизнес-риск, варианты решения и конкретный запрос с дедлайном.","main_goal":"Руководитель получает полную картину и может принять решение или назначить встречу для разрешения в кратчайшие сроки.","when_used":"После подготовки фактов и вариантов (SOP-02), когда горизонтальное решение исчерпано.","triggers":["Подготовка к эскалации завершена (SOP-02), коллега предупреждён о намерении эскалировать"],"preconditions":["Факты и варианты подготовлены и зафиксированы в Jira (SOP-02 выполнен)","Коллега предупреждён, что вопрос поднимается выше","Чеклист перед эскалацией пройден"],"inputs":["Ссылка на Jira-задачу с полным описанием эскалации","Контакт руководителя (своего и при необходимости другой стороны)"],"process_steps":[{"step":"Предупредить коллегу: «Я поднимаю вопрос выше, потому что на нашем уровне упёрлись в потолок полномочий» — формулировка: «Я эскалирую риск для проекта, а не тебя как человека»","description":""},{"step":"Написать своему руководителю (при необходимости добавить руководителя другой стороны)","description":""},{"step":"Дать ссылку на Jira-задачу и кратко сформулировать: контекст проекта и его важность для бизнеса","description":""},{"step":"Описать, что пробовали решить по горизонтали и почему не получилось (со ссылками на договорённости в Jira)","description":""},{"step":"Обозначить бизнес-риск: что произойдёт, если решение не будет принято","description":""},{"step":"Перечислить варианты решения и указать рекомендуемый вариант с обоснованием","description":""},{"step":"Сформулировать конкретный запрос: какое решение/приоритет нужно и до какой даты","description":""}],"outputs":["Руководитель получил эскалацию со ссылкой на Jira и конкретным запросом","Запущен процесс принятия решения на уровне руководства"],"result_location":"Jira-задача + сообщение руководителю (почта / мессенджер со ссылкой на Jira)","done_criteria":["Коллега предупреждён об эскалации до её отправки","Руководитель получил сообщение с ссылкой на Jira","Сообщение содержит: контекст, историю попыток, риск, варианты, конкретный запрос с датой","Фокус на бизнес-риске, а не на обвинениях"],"sla":"Отправка руководителю — в тот же рабочий день после завершения подготовки","typical_failures":[{"failure":"Эскалация за спиной коллеги — коллега не предупреждён","symptom":"","action":"Если руководитель недоступен — эскалировать через его заместителя или следующий уровень"},{"failure":"Сообщение руководителю без ссылки на Jira — нет контекста","symptom":"","action":"Если ситуация критическая — допускается параллельное уведомление нескольких руководителей"},{"failure":"Формулировки содержат обвинения вместо описания ситуации","symptom":"","action":""},{"failure":"Нет конкретного запроса — руководитель не понимает, что от него нужно","symptom":"","action":""},{"failure":"Нет дедлайна — решение откладывается на неопределённый срок","symptom":"","action":""}],"linked_templates_forms_links":["Шаблон сообщения руководителю об эскалации","Чеклист перед эскалацией"],"owner":"Инициатор эскалации","version":"3.0","updated_at":"2026-03-12"},"_id":"yqzce1sd21SrjJy2"}
{"domainId":"operational-management","domainPath":"operational-management/05-execution-control/04-problem-initiative-escalation/sop-01.json","level":"sop","folderPath":"05-execution-control/04-problem-initiative-escalation","fileName":"sop-01.json","type":"sop","data":{"name":"Как инициировать escalation и оформить recovery plan","type":"sop","purpose":"Как инициировать escalation и оформить recovery plan.","description":"Практическая инструкция: как инициировать escalation и оформить recovery plan.","main_goal":"Инициировать escalation и оформить recovery plan — выполнено.","when_used":"По наступлении триггера.","triggers":["Инициатива в red status / critical blocker"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Описать проблему: что пошло не так, какой impact, что уже пробовали","description":""},{"step":"Подготовить recovery plan: 3-5 конкретных actions для возвращения инициативы on track","description":""},{"step":"Для каждого action: owner, due date, expected result","description":""},{"step":"Определить: при каких условиях инициативу нужно pivot / kill вместо recovery","description":""},{"step":"Представить на initiative review / ops review для management decision","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Escalation без recovery plan — «у нас проблема, решайте»","symptom":"","action":""},{"failure":"Kill option не рассматривается — тратим ресурсы на безнадёжную инициативу","symptom":"","action":""},{"failure":"Recovery plan нереалистичный — те же действия, но «стараемся сильнее»","symptom":"","action":""}],"linked_templates_forms_links":[],"owner":"Initiative owner","version":"2.0","updated_at":"2026-03-12"},"_id":"yrfFupOIyAighecT"}
{"domainId":"operational-management","domainPath":"operational-management/02-priority-management/02-reprioritization/sop-02.json","level":"sop","folderPath":"02-priority-management/02-reprioritization","fileName":"sop-02.json","type":"sop","data":{"name":"Как обновить priority stack и согласовать trade-offs","type":"sop","purpose":"Как обновить priority stack и согласовать trade-offs.","description":"Практическая инструкция: как обновить priority stack и согласовать trade-offs.","main_goal":"Обновить priority stack и согласовать trade-offs — выполнено.","when_used":"По наступлении триггера.","triggers":["Варианты reprioritization подготовлены"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Представить варианты reprioritization со стейкхолдерами: что выигрываем, что теряем","description":""},{"step":"Принять решение: выбрать вариант, зафиксировать обоснование","description":""},{"step":"Обновить priority register: новый порядок, убранные/добавленные items","description":""},{"step":"Для каждого затронутого commitment определить: сдвиг сроков / сокращение scope / отмена","description":""},{"step":"Зафиксировать trade-off решения в decision log","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Priority register не обновлён — два источника правды","symptom":"","action":""},{"failure":"Trade-offs не зафиксированы — через месяц никто не помнит, почему так решили","symptom":"","action":""}],"linked_templates_forms_links":[],"owner":"COO / designated priority owner","version":"2.0","updated_at":"2026-03-12"},"_id":"z4BCcLXLf3dzlfhs"}
