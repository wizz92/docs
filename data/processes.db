{"domainId":"product-delivery","domainPath":"product-delivery/02-sprint-planning/process.json","level":"l2","folderPath":"02-sprint-planning","fileName":"process.json","type":"process_l2","data":{"name":"Планирование спринта","type":"process_l2","purpose":"Перевести приоритеты в конкретный план работы команды на спринт.","description":"Процесс подготовки к спринту, проведения sprint planning и управления scope.","main_goal":"Утверждённый sprint backlog с чётким sprint goal и проверенной capacity.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Приближение sprint planning","Завершение предыдущего спринта"],"inputs":["Prioritized backlog","Capacity info","Carry-over items"],"outputs":["Sprint goal","Sprint backlog","Capacity allocation"],"owner":"Scrum Master / Product Owner","participants":["Scrum Master","Product Owner","Development team","Tech Lead"],"linked_l3_subprocesses":["Подготовка к планированию спринта","Проведение sprint planning","Корректировка спринта mid-sprint"],"linked_sop":["Как проверить readiness к sprint planning","Как определить capacity команды на спринт","Как обработать carry-over items","Как провести sprint planning meeting","Как сформулировать sprint goal","Как обработать scope change request mid-sprint","Как мониторить sprint progress","Как реагировать на sprint risks","Как провести mid-sprint check"],"linked_meetings":["Sprint planning","Daily standup"],"process_steps":[{"step":"Подготовить backlog и capacity","description":"Убедиться, что достаточно refined items и известна capacity"},{"step":"Провести sprint planning","description":"Определить sprint goal, выбрать items, проверить feasibility"},{"step":"Управлять scope mid-sprint","description":"При необходимости — обсудить scope change через proper channel"}],"process_rhythm":[{"horizon":"Спринт","ritual":"Sprint planning","key_question":"Что команда берёт и на каком основании?","result":"Sprint goal + sprint backlog"}],"typical_failures":[{"failure":"Sprint planning затягивается","symptom":"Planning занимает полдня","action":"Timebox, приходить с refined backlog"},{"failure":"Scope меняется mid-sprint","symptom":"Добавляются items после начала спринта","action":"Только через PO, только при убирании чего-то"}],"linked_artifacts":[{"name":"Планирование спринта","description":"Основной артефакт процесса Планирование спринта"}],"linked_systems":["Jira","Confluence / wiki"],"metrics_signals":["Sprint goal achievement rate","Scope change mid-sprint"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"uJDGmVsAPNy4T03p"}
{"domainId":"operational-management","domainPath":"operational-management/03-capacity-management/01-capacity-load-review/sop-02.json","level":"sop","folderPath":"03-capacity-management/01-capacity-load-review","fileName":"sop-02.json","type":"sop","data":{"name":"Как сравнить load vs capacity и определить сигналы перегруза","type":"sop","purpose":"Как сравнить load vs capacity и определить сигналы перегруза.","description":"Практическая инструкция: как сравнить load vs capacity и определить сигналы перегруза.","main_goal":"Сравнить load vs capacity и определить сигналы перегруза — выполнено.","when_used":"По наступлении триггера.","triggers":["Capacity посчитан"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Собрать текущий load: все commitments команды (sprint items + ongoing work + maintenance + meetings)","description":""},{"step":"Сравнить с capacity: load / capacity ratio. Green: < 80%, Yellow: 80-95%, Red: > 95%","description":""},{"step":"Проверить carry-over: если > 20% scope из прошлого спринта перенесено — сигнал перегруза","description":""},{"step":"Проверить критичные роли: есть ли single points of failure с загрузкой > 100%?","description":""},{"step":"Зафиксировать результат в load summary","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Ongoing work не учтён — реальная загрузка выше, чем кажется","symptom":"","action":""},{"failure":"Carry-over не отслеживается — хронический перегруз не виден","symptom":"","action":""},{"failure":"Критичные роли не проверены — bottleneck на одном человеке","symptom":"","action":""}],"linked_templates_forms_links":["Load summary template"],"owner":"Team Lead / Operations lead","version":"2.0","updated_at":"2026-03-12"},"_id":"uSr7kkvZ246jMOlb"}
