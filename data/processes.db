{"domainId":"strategy-governance","domainPath":"strategy-governance/03-portfolio-prioritization/03-portfolio-rebalancing/process.json","level":"l3","folderPath":"03-portfolio-prioritization/03-portfolio-rebalancing","fileName":"process.json","type":"process_l3","data":{"name":"Ребалансировка портфеля","type":"process_l3","purpose":"Адаптировать портфель при изменении условий: новые приоритеты, потеря ресурсов, новые возможности.","description":"Процесс пересмотра и корректировки портфеля вне основного цикла.","main_goal":"Портфель всегда соответствует актуальным приоритетам и ресурсам.","when_used":"При существенном изменении вводных: новый приоритет от CEO, потеря ключевого ресурса, рыночное событие.","cadence":"Ad-hoc","triggers":["Существенное изменение приоритетов","Потеря ключевого ресурса","Новая срочная инициатива от CEO/Board"],"inputs":["Текущий ranked portfolio","Описание изменения","Impact assessment"],"outputs":["Updated ranked portfolio","Rebalancing decision log"],"owner":"COO","participants":["CEO","COO","Affected Heads of Functions"],"linked_meetings":["Ad-hoc portfolio rebalancing"],"linked_artifacts":["Rebalancing summary","Updated portfolio"],"linked_systems":["Jira Portfolio","Confluence / wiki"],"linked_sop":["Как оценить impact изменений на портфель","Как провести экстренную ребалансировку","Как зафиксировать решения по ребалансировке"],"done_criteria":["Портфель пересмотрен","Решения зафиксированы и донесены"],"typical_failures":[{"failure":"Ребалансировка не проводится — портфель устарел","symptom":"","action":"Ввести trigger-based ребалансировку"},{"failure":"Решения не доносятся до команд","symptom":"","action":"Обязательная рассылка решений в тот же день"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"OBJgpx9FZoieEtU9"}
{"domainId":"operational-management","domainPath":"operational-management/01-operational-planning/02-period-planning/sop-03.json","level":"sop","folderPath":"01-operational-planning/02-period-planning","fileName":"sop-03.json","type":"sop","data":{"name":"Как провести sprint planning и зафиксировать sprint goal","type":"sop","purpose":"Как провести sprint planning и зафиксировать sprint goal.","description":"Практическая инструкция: как провести sprint planning и зафиксировать sprint goal.","main_goal":"Провести sprint planning и зафиксировать sprint goal — выполнено.","when_used":"По наступлении триггера.","triggers":["Sprint planning meeting"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Озвучить фокус спринта: какие цели месяца / roadmap покрывает этот спринт","description":""},{"step":"Сформулировать sprint goal: одно предложение, описывающее ключевой результат спринта","description":""},{"step":"Отобрать items из backlog: начать с highest priority, двигаться вниз пока capacity позволяет","description":""},{"step":"Для каждого item подтвердить: estimation, owner, dependencies resolved","description":""},{"step":"Зафиксировать sprint backlog — заморозить scope (изменения только через PO с согласованием)","description":""},{"step":"Опубликовать sprint goal и backlog — убедиться, что вся команда видит и понимает","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Sprint goal не сформулирован — нет фокуса, спринт превращается в набор задач","symptom":"","action":""},{"failure":"Scope не заморожен — постоянные добавления разрушают plan","symptom":"","action":""},{"failure":"Items без owner — никто не чувствует ответственности","symptom":"","action":""}],"linked_templates_forms_links":["Sprint backlog (Jira)","Sprint goal template"],"owner":"Team Lead","version":"2.0","updated_at":"2026-03-12"},"_id":"OBLrmXIYMXL928ab"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/03-portfolio-prioritization/03-portfolio-rebalancing/sop-01.json","level":"sop","folderPath":"03-portfolio-prioritization/03-portfolio-rebalancing","fileName":"sop-01.json","type":"sop","data":{"name":"Как оценить impact изменений на портфель","type":"sop","purpose":"Быстро оценить, как изменение влияет на текущий портфель.","description":"Быстро оценить, как изменение влияет на текущий портфель.","main_goal":"Быстро оценить, как изменение влияет на текущий портфель.","when_used":"По триггеру процесса.","triggers":["Поступило существенное изменение"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Описать изменение: что произошло, какой масштаб","description":""},{"step":"Определить, какие инициативы затронуты","description":""},{"step":"Оценить impact на timeline и ресурсы","description":""},{"step":"Подготовить варианты решений","description":""},{"step":"Вынести на решение COO/CEO","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"COO","version":"1.0","updated_at":"2026-03-12"},"_id":"OJGpSPzwJ0xS2kDl"}
{"domainId":"business-development","domainPath":"business-development/02-growth-testing/02-experiment-execution/sop-02.json","level":"sop","folderPath":"02-growth-testing/02-experiment-execution","fileName":"sop-02.json","type":"sop","data":{"name":"Как мониторить эксперимент","type":"sop","purpose":"Отслеживать ход эксперимента и quality данных.","description":"Отслеживать ход эксперимента и quality данных.","main_goal":"Отслеживать ход эксперимента и quality данных.","when_used":"По триггеру процесса.","triggers":["Эксперимент запущен"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Ежедневно проверять data collection","description":""},{"step":"Фиксировать anomalies в experiment log","description":""},{"step":"На experiment standup — обновлять статус","description":""},{"step":"При критических проблемах — решать: fix или kill","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"Experiment owner","version":"1.0","updated_at":"2026-03-12"},"_id":"OLOkQ61cPyVyPWny"}
{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/03-escalation-management/sop-04.json","level":"sop","folderPath":"06-management-cadence-coordination/03-escalation-management","fileName":"sop-04.json","type":"sop","data":{"name":"Как зафиксировать решение в Jira и закрыть эскалацию","type":"sop","purpose":"Зафиксировать принятое руководителем решение в Jira-задаче с ответственным и сроком, уведомить участников и провести коммуникацию с коллегой для восстановления рабочих отношений.","description":"SOP покрывает два шага: (1) фиксация решения — в Jira-задаче фиксируется выбранный вариант, ответственный, дедлайн и согласовавший; (2) коммуникация с коллегой — совместный проход по решению, возврат фокуса на общую цель.","main_goal":"Эскалация закрыта формально (решение в Jira) и по-человечески (коллега в курсе, личный осадок снят).","when_used":"После того как руководитель принял решение по эскалации.","triggers":["Руководитель принял решение по эскалированному вопросу"],"preconditions":["Эскалация проведена (SOP-03 выполнен)","Руководитель озвучил или зафиксировал решение"],"inputs":["Принятое решение руководителя (выбранный вариант)","Jira-задача эскалации"],"process_steps":[{"step":"В той же Jira-задаче или в отдельной связанной карточке зафиксировать: принятое решение (выбранный вариант)","description":""},{"step":"Указать ответственного исполнителя за реализацию решения","description":""},{"step":"Указать конкретный дедлайн выполнения","description":""},{"step":"Указать, кто согласовал решение (имя/роль руководителя)","description":""},{"step":"Обновить статусы связанных задач в Jira","description":""},{"step":"Написать комментарий в задаче, уведомляющий всех участников о принятом решении","description":""},{"step":"Связаться с коллегой и вместе пройтись по принятому решению и действиям — цель: убрать личный осадок и вернуть фокус на общую цель","description":""},{"step":"Использовать формулировку: «Я эскалировал риск для проекта, а не тебя как человека»","description":""}],"outputs":["Jira-задача с зафиксированным решением, ответственным, сроком и согласовавшим","Участники уведомлены через комментарий в Jira","Коллега проинформирован о решении в личной коммуникации"],"result_location":"Jira — задача эскалации или связанная карточка","done_criteria":["В Jira зафиксировано: решение, ответственный, дедлайн, кто согласовал","Статусы связанных задач обновлены","Комментарий с уведомлением участников опубликован","С коллегой проведён разговор по итогам решения"],"sla":"Фиксация в Jira — в течение 1 рабочего дня после принятия решения","typical_failures":[{"failure":"Решение озвучено устно, но не зафиксировано в Jira — нет accountability","symptom":"","action":"Если руководитель принял промежуточное решение (нужно дообследовать) — зафиксировать промежуточный статус и назначить follow-up с датой"},{"failure":"Нет ответственного или нет дедлайна — решение повисает","symptom":"","action":"Если коллега отказывается от разговора — зафиксировать попытку, не настаивать, вернуться позже"},{"failure":"Коллега узнаёт о решении от третьих лиц, а не от инициатора","symptom":"","action":""},{"failure":"После решения не проведён разговор с коллегой — остаётся личный конфликт","symptom":"","action":""},{"failure":"Статусы связанных задач не обновлены — непрозрачность для команды","symptom":"","action":""}],"linked_templates_forms_links":["Шаблон фиксации решения в Jira","Чеклист закрытия эскалации"],"owner":"Инициатор эскалации","version":"3.0","updated_at":"2026-03-12"},"_id":"OXNQThOlmiVaOwuP"}
{"domainId":"finance-control","domainPath":"finance-control/03-plan-fact-analysis/02-variance-analysis/process.json","level":"l3","folderPath":"03-plan-fact-analysis/02-variance-analysis","fileName":"process.json","type":"process_l3","data":{"name":"Анализ отклонений","type":"process_l3","purpose":"Обеспечить выполнение анализ отклонений в рамках план-факт анализ.","description":"Процесс подготовки, проведения и контроля качества анализ отклонений.","main_goal":"Результат анализ отклонений соответствует стандартам и ожиданиям.","when_used":"В рамках план-факт анализ, по расписанию или по событию.","cadence":"Per cycle","triggers":["Наступление срока анализ отклонений","Запрос от руководства"],"inputs":["Данные для анализ отклонений","Регламент процесса","Предыдущие результаты"],"outputs":["Результат анализ отклонений","Отчёт / summary","Action items"],"owner":"Finance analyst / CFO","participants":["Finance analyst","CFO","Heads of Functions"],"linked_meetings":["Анализ отклонений meeting"],"linked_artifacts":["Анализ отклонений template"],"linked_systems":["Confluence / wiki","Jira"],"linked_sop":["Как подготовиться к анализ отклонений","Как провести анализ отклонений","Как оценить результаты анализ отклонений"],"done_criteria":["Результат анализ отклонений принят","Отчёт подготовлен"],"typical_failures":[{"failure":"Задержка в анализ отклонений","symptom":"","action":"Эскалировать на owner"},{"failure":"Неполные данные","symptom":"","action":"Перенести на следующий цикл с причиной"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"OcGtKtHai0kHNMZ0"}
{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/04-decision-followup/sop-02.json","level":"sop","folderPath":"06-management-cadence-coordination/04-decision-followup","fileName":"sop-02.json","type":"sop","data":{"name":"Как контролировать исполнение решений","type":"sop","purpose":"Как контролировать исполнение решений.","description":"Практическая инструкция: как контролировать исполнение решений.","main_goal":"Контролировать исполнение решений — выполнено.","when_used":"По наступлении триггера.","triggers":["Перед каждым weekly ops review"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Перед каждым weekly review: пройти по open actions — проверить статус","description":""},{"step":"Для done actions: подтвердить completion, закрыть","description":""},{"step":"Для in progress: проверить, что on track к due date","description":""},{"step":"Для overdue: вынести на review — owner объясняет причину, новый due date или escalation","description":""},{"step":"Вести простую статистику: closure rate, average time to close (для отслеживания дисциплины)","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Actions не проверяются — list растёт бесконечно","symptom":"","action":""},{"failure":"Overdue actions не обсуждаются — дисциплина падает","symptom":"","action":""}],"linked_templates_forms_links":[],"owner":"Operations lead","version":"2.0","updated_at":"2026-03-12"},"_id":"OgfCFiGyaMHln6TA"}
{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/03-escalation-management/sop-01.json","level":"sop","folderPath":"06-management-cadence-coordination/03-escalation-management","fileName":"sop-01.json","type":"sop","data":{"name":"Как определить необходимость эскалации и попробовать решить по горизонтали","type":"sop","purpose":"Убедиться, что ситуация действительно требует эскалации, и предпринять финальную попытку горизонтального решения через Jira.","description":"SOP покрывает два шага: (1) валидация — действительно ли есть бизнес-риск и были ли попытки решить по горизонтали; (2) финальная попытка — формулировка запроса коллеге с фиксацией в Jira-задаче и дедлайном.","main_goal":"Отсечь ложные эскалации и дать последний шанс решить вопрос на уровне команд.","when_used":"Когда возникает ощущение, что вопрос «упёрся в потолок» и горизонтальное решение не работает.","triggers":["Есть существенный бизнес-риск (сроки, выручка, качество, нагрузка на команду) и как минимум одна неудачная попытка договориться по горизонтали"],"preconditions":["Есть конкретная проблема, влияющая на бизнес-результат","Минимум 1 попытка решить вопрос с коллегой уже была (созвон, переписка, поиск компромисса)"],"inputs":["Описание проблемы и бизнес-риска","История попыток решить по горизонтали (даты, суть переговоров)"],"process_steps":[{"step":"Проверить: есть ли существенный риск для сроков, денег, качества или нагрузки на команду — если нет, эскалация не нужна","description":""},{"step":"Проверить: были ли минимум 1–2 попытки решить вопрос по горизонтали (созвон, переписка, поиск компромисса) — если нет, сначала попробовать","description":""},{"step":"Проверить: были ли договорённости зафиксированы в Jira (задача/комментарий), но не выполнены — если договорённостей не было, зафиксировать их","description":""},{"step":"Сформулировать коллеге, что конкретно нужно и к какому сроку, и почему это важно для бизнеса","description":""},{"step":"Создать или обновить Jira-задачу (тип BLOCKER): понятное описание ожидаемого результата, ответственный со стороны коллеги, дедлайн, ссылка на эпик/основные задачи","description":""},{"step":"Зафиксировать договорённости в комментарии в Jira","description":""},{"step":"Дождаться результата: если коллега не укладывается в договорённость, не может предложить рабочий вариант, а бизнес-риск сохраняется — переходить к подготовке эскалации (SOP-02)","description":""}],"outputs":["Jira-задача с зафиксированными договорённостями, ответственным и дедлайном","Решение: вопрос закрыт по горизонтали ИЛИ подтверждена необходимость эскалации"],"result_location":"Jira — задача/комментарий с фиксацией договорённостей","done_criteria":["Проведена валидация по трём критериям: бизнес-риск, попытки решить, фиксация в Jira","Финальная попытка решить по горизонтали предпринята и зафиксирована в Jira","Принято решение: закрыть вопрос ИЛИ готовить эскалацию"],"sla":"Финальная попытка — не более 2 рабочих дней от момента фиксации в Jira","typical_failures":[{"failure":"Эскалация «сгоряча» — без реальных попыток договориться","symptom":"","action":"Если бизнес-риск критический (блокирует revenue/production) — допускается ускоренный переход к эскалации после одной зафиксированной попытки"},{"failure":"Проблема описана как личная обида, а не бизнес-риск","symptom":"","action":"Если коллега недоступен более 1 рабочего дня — зафиксировать попытку связаться и переходить к подготовке эскалации"},{"failure":"Договорённости не зафиксированы в Jira — нет доказательной базы","symptom":"","action":""},{"failure":"Эскалация по мелкому поводу, не влияющему на бизнес-результат","symptom":"","action":""}],"linked_templates_forms_links":["Чеклист перед эскалацией (см. guideline)","Шаблон Jira-задачи типа BLOCKER"],"owner":"Инициатор эскалации (любой руководитель / Team Lead)","version":"3.0","updated_at":"2026-03-12"},"_id":"P54kT6tzU8BTgX34"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/03-portfolio-prioritization/01-initiative-intake/process.json","level":"l3","folderPath":"03-portfolio-prioritization/01-initiative-intake","fileName":"process.json","type":"process_l3","data":{"name":"Сбор инициатив в портфель","type":"process_l3","purpose":"Обеспечить единый реестр всех инициатив компании.","description":"Процесс приёма, регистрации и первичной оценки новых инициатив.","main_goal":"Все инициативы зарегистрированы, имеют owner, описание и первичную оценку.","when_used":"При появлении новой инициативы или перед portfolio review.","cadence":"Continuous + quarterly batch","triggers":["Новая бизнес-идея","Запрос от CEO/Board","Подготовка к portfolio review"],"inputs":["Initiative proposal","Business case draft","Стратегические приоритеты"],"outputs":["Registered initiative in portfolio","Initial scoring"],"owner":"Head of Strategy / PMO","participants":["Initiative owner","Head of Strategy","COO"],"linked_meetings":["Initiative intake review"],"linked_artifacts":["Portfolio register","Initiative proposal template"],"linked_systems":["Jira Portfolio","Confluence / wiki"],"linked_sop":["Как зарегистрировать новую инициативу","Как провести первичную оценку инициативы","Как подготовить portfolio register к review"],"done_criteria":["Инициатива зарегистрирована в реестре","Owner назначен","Первичный scoring проведён"],"typical_failures":[{"failure":"Инициативы запускаются без регистрации","symptom":"","action":"Ввести обязательную регистрацию перед выделением ресурсов"},{"failure":"Нет стандартного формата описания","symptom":"","action":"Создать и внедрить шаблон initiative proposal"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"PE0mnuPYfDemTtLx"}
{"domainId":"finance-control","domainPath":"finance-control/03-plan-fact-analysis/01-actual-data-collection/sop-02.json","level":"sop","folderPath":"03-plan-fact-analysis/01-actual-data-collection","fileName":"sop-02.json","type":"sop","data":{"name":"Как провести сбор фактических данных","type":"sop","purpose":"Выполнить сбор фактических данных по установленной процедуре.","description":"Выполнить сбор фактических данных по установленной процедуре.","main_goal":"Выполнить сбор фактических данных по установленной процедуре.","when_used":"По триггеру процесса.","triggers":["Все inputs для сбор фактических данных готовы"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Начать выполнение сбор фактических данных по процедуре","description":""},{"step":"Фиксировать промежуточные результаты","description":""},{"step":"При отклонениях — уведомить owner","description":""},{"step":"Завершить и проверить результат","description":""},{"step":"Зафиксировать outputs","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"Finance analyst / CFO","version":"1.0","updated_at":"2026-03-12"},"_id":"PIneMcm1gSz1l1DU"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/01-strategic-planning/03-strategy-communication/sop-03.json","level":"sop","folderPath":"01-strategic-planning/03-strategy-communication","fileName":"sop-03.json","type":"sop","data":{"name":"Как поддерживать актуальность strategy FAQ","type":"sop","purpose":"Обеспечить единый источник ответов на вопросы по стратегии.","description":"Обеспечить единый источник ответов на вопросы по стратегии.","main_goal":"Обеспечить единый источник ответов на вопросы по стратегии.","when_used":"По триггеру процесса.","triggers":["Появление новых вопросов от сотрудников"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Собрать вопросы из всех каналов","description":""},{"step":"Подготовить ответы совместно с CEO/COO","description":""},{"step":"Обновить FAQ страницу в wiki","description":""},{"step":"Уведомить команды об обновлении","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"CEO / Head of Communications","version":"1.0","updated_at":"2026-03-12"},"_id":"PVZIqJE1cgtslMBD"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/process.json","level":"l1","folderPath":"","fileName":"process.json","type":"process_l1","data":{"name":"Strategy & Governance","type":"process_l1","purpose":"Обеспечить компанию согласованной стратегической рамкой: определить направление развития, приоритеты инвестиций и правила управления.","description":"Домен охватывает формирование стратегии, каскадирование целей на все уровни и приоритизацию портфеля инициатив.","main_goal":"Компания имеет актуальную стратегию, цели декомпозированы до команд, портфель инициатив приоритизирован и управляем.","scope":"Стратегическое планирование, целеполагание, портфельная приоритизация, governance правила.","when_used":"Постоянно, как системный домен управления.","triggers":["Начало нового управленческого цикла","Изменение стратегических приоритетов","Регулярный review"],"inputs":["Стратегические цели","Данные из систем","Feedback от команд"],"outputs":["Управленческие решения","Стандартизированные процессы","Отчётность"],"owner":"CEO / CSO","participants":["CEO","COO","CFO","Heads of Functions","Board / Advisory"],"linked_meetings":["Strategy offsite","Quarterly goal-setting","Portfolio review"],"linked_artifacts":["Стратегический документ","OKR framework","Portfolio register"],"linked_systems":["Confluence / wiki","BI dashboards","OKR tool"],"metrics_signals":["Доля целей, достигнутых за квартал","Скорость каскадирования целей","Процент инициатив без owner"],"review_cadence":"Quarterly review of domain structure; monthly review of effectiveness.","access_level":"Management / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"PqqbifG8jgbE63TX"}
{"domainId":"revenue-operations","domainPath":"revenue-operations/03-revenue-analysis/01-revenue-data-collection/sop-01.json","level":"sop","folderPath":"03-revenue-analysis/01-revenue-data-collection","fileName":"sop-01.json","type":"sop","data":{"name":"Как подготовиться к сбор данных по выручке","type":"sop","purpose":"Обеспечить готовность к выполнению сбор данных по выручке.","description":"Обеспечить готовность к выполнению сбор данных по выручке.","main_goal":"Обеспечить готовность к выполнению сбор данных по выручке.","when_used":"По триггеру процесса.","triggers":["Приближение срока сбор данных по выручке"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Определить входные данные для сбор данных по выручке","description":""},{"step":"Собрать необходимую информацию от ответственных","description":""},{"step":"Проверить готовность по чек-листу","description":""},{"step":"Согласовать план с owner","description":""},{"step":"Зафиксировать в рабочем документе","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"Head of Revenue / CFO","version":"1.0","updated_at":"2026-03-12"},"_id":"PricUPxiSiJuuRKQ"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/02-goal-setting/03-goal-review/process.json","level":"l3","folderPath":"02-goal-setting/03-goal-review","fileName":"process.json","type":"process_l3","data":{"name":"Ревью и корректировка целей","type":"process_l3","purpose":"Регулярно проверять прогресс по целям и корректировать при необходимости.","description":"Процесс мониторинга прогресса OKR, выявления отклонений и принятия корректирующих решений.","main_goal":"Прогресс по целям прозрачен, отклонения выявлены рано, корректировки приняты своевременно.","when_used":"Ежемесячно и по итогам квартала.","cadence":"Monthly + end-of-quarter","triggers":["Наступление даты monthly OKR review","Конец квартала"],"inputs":["Текущий прогресс по OKR","Данные из систем","Feedback от команд"],"outputs":["OKR status report","Решения по корректировке","Updated OKR (при необходимости)"],"owner":"COO","participants":["CEO","COO","Heads of Functions"],"linked_meetings":["Monthly OKR review","Quarterly OKR retrospective"],"linked_artifacts":["OKR status dashboard","Review summary"],"linked_systems":["OKR tool","BI dashboards"],"linked_sop":["Как провести monthly OKR review","Как провести quarterly OKR retrospective","Как скорректировать OKR mid-quarter"],"done_criteria":["Статус по всем OKR обновлён","Решения по отклонениям зафиксированы"],"typical_failures":[{"failure":"Review проводится формально","symptom":"","action":"Ввести обязательный action plan для каждого off-track OKR"},{"failure":"Отклонения не приводят к действиям","symptom":"","action":"Эскалировать системные отклонения на CEO"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"PxLcNik92M2YbqJA"}
{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/03-escalation-management/sop-02.json","level":"sop","folderPath":"06-management-cadence-coordination/03-escalation-management","fileName":"sop-02.json","type":"sop","data":{"name":"Как подготовить факты и варианты для эскалации","type":"sop","purpose":"Собрать факты, оценить бизнес-риски и подготовить варианты решения, чтобы руководитель мог быстро принять решение по одной ссылке на Jira.","description":"Структурированная подготовка к эскалации: описание проблемы, хронология фактов, оценка рисков, формулировка минимум двух вариантов решения. Всё собирается в описании или комментарии в Jira-задаче.","main_goal":"Руководитель видит полную картину по одной ссылке и может принять решение без дополнительных уточнений.","when_used":"После подтверждения необходимости эскалации (SOP-01), перед передачей вопроса руководителю.","triggers":["Финальная попытка решить по горизонтали не дала результата, бизнес-риск сохраняется"],"preconditions":["Пройдена валидация по SOP-01: бизнес-риск подтверждён, попытки горизонтального решения зафиксированы","Есть Jira-задача с историей договорённостей"],"inputs":["Jira-задача с историей договорённостей и комментариями","Даты запросов, созвонов, обещанных сроков","Понимание бизнес-последствий (сроки, выручка, качество, репутация)"],"process_steps":[{"step":"Сформулировать суть проблемы в 1–2 предложениях: что за блокер и где именно он возникает","description":""},{"step":"Собрать факты: даты запросов, созвонов, обещанных сроков, ссылки на Jira-комментарии с предыдущими договорённостями","description":""},{"step":"Описать бизнес-риски: чем грозит ситуация — сдвиг релиза, недополученная выручка, репутационный ущерб, перегруз команды и т.п.","description":""},{"step":"Подготовить минимум 2 варианта решения с пониманием последствий каждого (сроки, ресурсы, trade-offs)","description":""},{"step":"Сформулировать рекомендуемый вариант и обосновать выбор","description":""},{"step":"Собрать всё в описании или комментарии Jira-задачи, чтобы руководитель видел полную картину по одной ссылке","description":""},{"step":"Пройти чеклист: могу описать бизнес-проблему (не личную обиду), есть факты и ссылки (не только эмоции), есть 2+ вариантов, в формулировках нет обвинений","description":""}],"outputs":["Jira-задача/комментарий с полным описанием: суть проблемы, факты, риски, варианты решения, рекомендация","Готовая ссылка для отправки руководителю"],"result_location":"Jira — описание или комментарий в задаче эскалации","done_criteria":["Суть проблемы описана в 1–2 предложениях без обвинений","Факты собраны: даты, ссылки на Jira, хронология","Бизнес-риски конкретизированы","Подготовлены минимум 2 варианта решения с последствиями","Всё зафиксировано в Jira по одной ссылке","Чеклист перед эскалацией пройден"],"sla":"Подготовка — в течение 1 рабочего дня","typical_failures":[{"failure":"Описание проблемы содержит обвинения вместо фактов","symptom":"","action":"Если невозможно собрать полные факты (данные у другой стороны) — зафиксировать имеющееся и указать, какая информация отсутствует"},{"failure":"Нет вариантов решения — руководителю нечего выбирать","symptom":"","action":"Если ситуация критическая и нет времени на полную подготовку — допускается краткий формат: суть + риск + 1 вариант, с дополнением после первого контакта с руководителем"},{"failure":"Факты разбросаны по чатам и не собраны в одном месте","symptom":"","action":""},{"failure":"Риски описаны абстрактно, без привязки к конкретным бизнес-последствиям","symptom":"","action":""},{"failure":"Только один вариант решения — нет альтернативы для принятия решения","symptom":"","action":""}],"linked_templates_forms_links":["Чеклист перед эскалацией","Шаблон описания эскалации в Jira"],"owner":"Инициатор эскалации","version":"3.0","updated_at":"2026-03-12"},"_id":"Pxet4mG0GetFGRlp"}
{"domainId":"strategy-governance","domainPath":"strategy-governance/03-portfolio-prioritization/02-portfolio-ranking/process.json","level":"l3","folderPath":"03-portfolio-prioritization/02-portfolio-ranking","fileName":"process.json","type":"process_l3","data":{"name":"Приоритизация портфеля","type":"process_l3","purpose":"Ранжировать инициативы и принять решения о распределении ресурсов.","description":"Проведение scoring, forced ranking и принятие решений по приоритетам портфеля.","main_goal":"Приоритизированный портфель с чёткими решениями: что делаем, что откладываем, что убираем.","when_used":"Перед началом квартала и при существенном изменении ресурсов.","cadence":"Quarterly","triggers":["Начало квартального цикла","Существенное изменение capacity"],"inputs":["Portfolio register","Capacity plan","Strategic priorities"],"outputs":["Ranked portfolio","Resource allocation decisions","Parked initiatives list"],"owner":"COO","participants":["CEO","COO","Heads of Functions"],"linked_meetings":["Portfolio prioritization session"],"linked_artifacts":["Ranked portfolio","Decision log"],"linked_systems":["Jira Portfolio","Spreadsheet trackers"],"linked_sop":["Как провести portfolio prioritization session","Как распределить ресурсы по инициативам","Как коммуницировать решения по портфелю"],"done_criteria":["Все инициативы ранжированы","Решения по ресурсам зафиксированы","Parked list утверждён"],"typical_failures":[{"failure":"Не удалось достигнуть consensus по ranking","symptom":"","action":"CEO принимает финальное решение при отсутствии consensus"},{"failure":"Capacity переоценена","symptom":"","action":"Пересчитать capacity с buffer 20%"}],"version":"1.0","updated_at":"2026-03-12"},"_id":"QFSvHFf6nsy0Sh98"}
{"domainId":"operational-management","domainPath":"operational-management/05-execution-control/04-problem-initiative-escalation/process.json","level":"l3","folderPath":"05-execution-control/04-problem-initiative-escalation","fileName":"process.json","type":"process_l3","data":{"name":"Эскалация проблемных инициатив","type":"process_l3","purpose":"Обеспечить быстрое реагирование на инициативы, которые в trouble.","description":"Когда инициатива off track и corrective actions недостаточны — эскалация, формирование recovery plan, контроль исполнения.","main_goal":"Проблемные инициативы не зависают — решения принимаются, recovery plans исполняются.","when_used":"Когда инициатива off track / red status / critical blockers.","cadence":"По необходимости","triggers":["Инициатива в red status / critical blocker / missed critical milestone"],"inputs":["Initiative status","Variance analysis","Attempted corrective actions"],"outputs":["Escalation case","Recovery plan","Management decision"],"owner":"Initiative owner / Operations lead","participants":["Heads of Functions","COO","Affected team leads"],"linked_meetings":["Initiative review","Ops review"],"linked_artifacts":["Recovery plan","Escalation record"],"linked_systems":["Jira","Confluence"],"linked_sop":["Как инициировать escalation и оформить recovery plan","Как вести follow-up по escalated initiative","Как закрыть escalation case"],"done_criteria":["Escalation зафиксирована","Recovery plan создан","Management decision принято"],"typical_failures":[{"failure":"Проблемная инициатива тихо умирает без escalation","symptom":"","action":"Если recovery plan не работает через 2 спринта — пересмотреть: continue / pivot / kill"},{"failure":"Recovery plan формальный — не исполняется","symptom":"","action":""}],"version":"2.0","updated_at":"2026-03-12"},"_id":"QRRlU8tEpntISkTy"}
{"domainId":"hr-organization","domainPath":"hr-organization/01-recruitment/03-offer-decision/sop-02.json","level":"sop","folderPath":"01-recruitment/03-offer-decision","fileName":"sop-02.json","type":"sop","data":{"name":"Как провести принятие решения и оффер","type":"sop","purpose":"Выполнить принятие решения и оффер по установленной процедуре.","description":"Выполнить принятие решения и оффер по установленной процедуре.","main_goal":"Выполнить принятие решения и оффер по установленной процедуре.","when_used":"По триггеру процесса.","triggers":["Все inputs для принятие решения и оффер готовы"],"preconditions":["Определены ответственные","Доступны необходимые данные и инструменты"],"inputs":["Данные предыдущего этапа","Регламент / шаблон"],"process_steps":[{"step":"Начать выполнение принятие решения и оффер по процедуре","description":""},{"step":"Фиксировать промежуточные результаты","description":""},{"step":"При отклонениях — уведомить owner","description":""},{"step":"Завершить и проверить результат","description":""},{"step":"Зафиксировать outputs","description":""}],"outputs":["Результат выполнения","Обновлённый статус"],"result_location":"Confluence / wiki или рабочая система","done_criteria":["Результат зафиксирован","Stakeholders уведомлены"],"sla":"Согласно регламенту процесса","typical_failures":[{"failure":"Пропущен шаг процедуры","symptom":"","action":"Уведомить owner процесса"},{"failure":"Неполные входные данные","symptom":"","action":"Зафиксировать отклонение и причину"}],"linked_templates_forms_links":["Шаблон в Confluence"],"owner":"Recruiter / Hiring Manager","version":"1.0","updated_at":"2026-03-12"},"_id":"REed0c57aP3DGtU1"}
