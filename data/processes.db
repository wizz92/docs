{"domainId":"transformation-automation","domainPath":"transformation-automation/02-workflow-automation/process.json","level":"l2","folderPath":"02-workflow-automation","fileName":"process.json","type":"process_l2","data":{"name":"Автоматизация рабочих процессов","type":"process_l2","purpose":"Автоматизировать рутинные workflows для повышения эффективности.","description":"Процесс идентификации, разработки и внедрения автоматизаций.","main_goal":"Рутинные workflows автоматизированы, экономия времени измерима.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Начало цикла автоматизация рабочих процессов","Запрос от руководства"],"inputs":["Данные для автоматизация рабочих процессов","Стратегические приоритеты","Предыдущие результаты"],"outputs":["Результат автоматизация рабочих процессов","Управленческие решения"],"owner":"Automation Lead / Head of IT","participants":["Automation Lead","Business analyst","IT","Process owners"],"linked_l3_subprocesses":["Идентификация кандидатов на автоматизацию","Разработка автоматизации","Внедрение и мониторинг"],"linked_sop":["Как подготовиться к идентификация кандидатов на автоматизацию","Как провести идентификация кандидатов на автоматизацию","Как оценить результаты идентификация кандидатов на автоматизацию","Как подготовиться к разработка автоматизации","Как провести разработка автоматизации","Как оценить результаты разработка автоматизации","Как подготовиться к внедрение и мониторинг","Как провести внедрение и мониторинг","Как оценить результаты внедрение и мониторинг"],"linked_meetings":["Workflow Automation review"],"process_steps":[{"step":"Подготовить inputs для автоматизация рабочих процессов","description":"Собрать данные, проверить готовность"},{"step":"Провести автоматизация рабочих процессов","description":"Выполнить основные действия процесса"},{"step":"Оценить результат и принять решения","description":"Проверить outputs, зафиксировать решения"}],"process_rhythm":[{"horizon":"Per cycle","ritual":"