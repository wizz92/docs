{"domainId":"it-systems-security","domainPath":"it-systems-security/02-workplace-support/process.json","level":"l2","folderPath":"02-workplace-support","fileName":"process.json","type":"process_l2","data":{"name":"Поддержка рабочих мест","type":"process_l2","purpose":"Обеспечить сотрудников рабочим оборудованием, ПО и техподдержкой.","description":"Процесс обработки заявок, управления оборудованием и лицензиями.","main_goal":"Сотрудники обеспечены рабочими инструментами, заявки обрабатываются в SLA.","when_used":"Регулярно, в рамках управленческого цикла.","triggers":["Начало цикла поддержка рабочих мест","Запрос от руководства"],"inputs":["Данные для поддержка рабочих мест","Стратегические приоритеты","Предыдущие результаты"],"outputs":["Результат поддержка рабочих мест","Управленческие решения"],"owner":"IT Support Lead","participants":["IT Support team","HR","Procurement"],"linked_l3_subprocesses":["Обработка заявок на поддержку","Управление оборудованием","Управление лицензиями ПО"],"linked_sop":["Как подготовиться к обработка заявок на поддержку","Как провести обработка заявок на поддержку","Как оценить результаты обработка заявок на поддержку","Как подготовиться к управление оборудованием","Как провести управление оборудованием","Как оценить результаты управление оборудованием","Как подготовиться к управление лицензиями по","Как провести управление лицензиями по","Как оценить результаты управление лицензиями по"],"linked_meetings":["Workplace Support review"],"process_steps":[{"step":"Подготовить inputs для поддержка рабочих мест","description":"Собрать данные, проверить готовность"},{"step":"Провести поддержка рабочих мест","description":"Выполнить основные действия процесса"},{"step":"Оценить результат и принять решения","description":"Проверить outputs, зафиксировать решения"}],"process_rhythm":[{"horizon":"Per cycle","ritual":"Workplace Support review","key_question":"Как работает поддержка рабочих мест?","result":"Decisions and improvements"}],"typical_failures":[{"failure":"Поддержка рабочих мест не проводится регулярно","symptom":"Пропуски циклов, нет данных","action":"Зафиксировать cadence, назначить ответственного"}],"linked_artifacts":[{"name":"Поддержка рабочих мест","description":"Основной артефакт процесса Поддержка рабочих мест"}],"linked_systems":["Jira","Confluence / wiki","BI dashboards"],"metrics_signals":["Эффективность поддержка рабочих мест","Время цикла"],"review_cadence":"Quarterly review of process design; monthly review of effectiveness.","access_level":"Management / leads / process owners","version":"1.0","updated_at":"2026-03-12"},"_id":"f1WaEdy2zmlmHhbz"}
{"domainId":"operational-management","domainPath":"operational-management/06-management-cadence-coordination/01-regular-reviews/sop-03.json","level":"sop","folderPath":"06-management-cadence-coordination/01-regular-reviews","fileName":"sop-03.json","type":"sop","data":{"name":"Как подготовить и провести initiative review","type":"sop","purpose":"Как подготовить и провести initiative review.","description":"Практическая инструкция: как подготовить и провести initiative review.","main_goal":"Подготовить и провести initiative review — выполнено.","when_used":"По наступлении триггера.","triggers":["Bi-weekly / monthly (зависит от portfolio)"],"preconditions":[],"inputs":[],"process_steps":[{"step":"Собрать актуальные initiative summaries от owners (status, milestones, risks, confidence)","description":""},{"step":"Сформировать agenda: фокус на at risk / behind инициативах, blocked dependencies, decisions needed","description":""},{"step":"Highlight problem areas: инициативы с confidence level low или с missed milestones","description":""},{"step":"Провести review: owner каждой problem initiative даёт 3-5 мин update + recommendation","description":""},{"step":"Принять решения: continue as-is / adjust plan / add resources / escalate / kill","description":""},{"step":"Зафиксировать решения и action items","description":""}],"outputs":[],"result_location":"Jira / Confluence / трекер","done_criteria":["Все шаги выполнены, результат зафиксирован"],"sla":"В рамках текущего цикла","typical_failures":[{"failure":"Все инициативы обсуждаются одинаково — время тратится на healthy ones","symptom":"","action":""},{"failure":"Owner не подготовил summary — review вслепую","symptom":"","action":""},{"failure":"Решения не принимаются — «подождём ещё»","symptom":"","action":""}],"linked_templates_forms_links":["Initiative review agenda","Initiative summary template"],"owner":"COO / Operations lead","version":"2.0","updated_at":"2026-03-12"},"_id":"f7Tv7o5yh4Abmq1L"}
